    "Change your Patch now. Insulin delivery will stop in {0} or when no more insulin remains." : {
      "comment" : "description for grace period notice",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賯賲 亘鬲睾賷賷乇 丕賱賱氐賯丞 丕賱丌賳. 爻賷鬲賵賯賮 鬲賵氐賷賱 丕賱兀賳爻賵賱賷賳 禺賱丕賱 %@ 兀賵 毓賳丿賲丕 賱丕 賷鬲亘賯賶 丕賱賲夭賷丿 賲賳 丕賱兀賳爻賵賱賷賳."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zm臎艌te svou z谩platu. Pod谩v谩n铆 inzul铆nu se zastav铆 za %@ nebo a啪 nezbude 啪谩dn媒 dal拧铆 inzul铆n."
          }
